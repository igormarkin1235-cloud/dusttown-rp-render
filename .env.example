# Set this in Render from BotFather; never commit an actual token.
TELEGRAM_BOT_TOKEN=

# Telegram group username (for example @DustTownCollective) or numeric chat ID.
TELEGRAM_GROUP_ID=@DustTownCollective

# Optional: enables Gemini replies and Littlepip TTS. Text replies use the
# embedded local generator when this key is absent.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Admin credentials are server-only. Keep these values out of GitHub.
# Paste the complete service account JSON; escaped \\n in private_key is supported.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=

# Enable YouTube Data API v3 in Google Cloud and keep this key server-side.
YOUTUBE_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
